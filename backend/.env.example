DATABASE_URL=postgresql://incidents:incidents@localhost:5432/incidents
OPENAI_API_KEY=sk-your-key-here
ENVIRONMENT=development
LOG_LEVEL=INFO
# CORS origins as a comma-separated list. Default is "*" (credentials disabled
# while wildcard). For production, set explicit origins, e.g.
# CORS_ORIGINS=https://app.example.com
CORS_ORIGINS=*
LLM_MODEL=gpt-4o-mini
SCAN_TMP_DIR=./.scan-tmp
MAX_REPO_SIZE_MB=50
MAX_SCAN_FILES=2000
MAX_LLM_FILES=10
MAX_LLM_FILE_CHARS=12000
MAX_LLM_INPUT_CHARS=600000
SCAN_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org
SCAN_MAX_CONCURRENT=2
# ZIP upload scans
MAX_ZIP_MB=50
MAX_ZIP_ENTRIES=5000
# Live URL scans (non-destructive checks)
URL_CHECK_TIMEOUT=10
# Set true only in isolated test environments; live scans reject private/loopback hosts by default
URL_ALLOW_PRIVATE_IP=false
# Dependency vulnerability checking: offline curated DB by default; set true to enrich via OSV API
OSV_API_ENABLED=false
SECURITY_SCAN_VERSION=1.0.0